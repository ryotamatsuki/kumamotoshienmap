{
  "name": "ehime-kumamoto-support-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:volunteer": "node scripts/generate-volunteer-data.mjs",
    "update:current-shelters": "node scripts/update-current-shelters.mjs",
    "generate:current-shelter-data": "node scripts/generate-current-shelter-data.mjs",
    "validate:dashboard": "node scripts/validate-dashboard-current.mjs",
    "validate:current-state": "node scripts/validate-current-state-audit.mjs",
    "validate:timeline": "node scripts/validate-timeline-order.mjs",
    "validate:dist": "node scripts/validate-built-site.mjs",
    "validate:volunteer": "node scripts/validate-volunteer-data.mjs",
    "validate:shelters": "node scripts/validate-shelter-coordinates.mjs",
    "validate:current-shelters": "node scripts/validate-current-shelters.mjs",
    "validate:ehime-sender-coverage": "node scripts/validate-sender-coverage.mjs --scope=ehime",
    "validate:nationwide-sender-coverage": "node scripts/validate-sender-coverage.mjs --scope=nationwide",
    "validate:sender-source-mentions": "node scripts/validate-sender-coverage.mjs --scope=mentions",
    "validate:sender-coverage": "node scripts/validate-sender-coverage.mjs --scope=all",
    "validate:release": "node scripts/validate-release-with-sender.mjs",
    "test:release-gate": "node scripts/test-release-gate.mjs && node scripts/test-sender-coverage-gates.mjs",
    "sync:sender-dist": "node scripts/sync-sender-dist.mjs",
    "validate:sender-dist": "node scripts/validate-sender-dist.mjs",
    "build": "npm run generate:volunteer && npm run generate:current-shelter-data && npm run sync:municipal-support && npm run sync:national-support && npm run sync:page-metadata && npm run validate:dashboard && npm run validate:current-state && npm run validate:timeline && npm run validate:volunteer && npm run validate:shelters && npm run validate:current-shelters && npm run validate:municipal-support && npm run validate:national-support && npm run validate:institution-coverage && npm run validate:sender-coverage && node scripts/build-sites.mjs && npm run sync:sender-dist && npm run validate:dist && npm run validate:sender-dist",
    "sync:page-metadata": "node scripts/sync-current-page-metadata.mjs",
    "sync:municipal-support": "node scripts/sync-municipal-support-audit.mjs",
    "validate:municipal-support": "node scripts/validate-municipal-support-audit.mjs",
    "sync:national-support": "node scripts/sync-national-support-audit.mjs",
    "validate:national-support": "node scripts/validate-national-support-audit.mjs",
    "validate:institution-coverage": "node scripts/validate-institution-coverage.mjs"
  }
}
