{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryotamatsuki/kumamotoshienmap/schema/update-ledger-v1.json",
  "title": "Kumamoto Support Map Update Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "update_type",
    "gate_phase",
    "update_id",
    "release_id",
    "reference_at",
    "page_checked_at",
    "base_main_sha",
    "expected_changed_files",
    "sources",
    "coverage",
    "unresolved"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "const": "ryotamatsuki/kumamotoshienmap" },
    "update_type": { "const": "timepoint_refresh" },
    "gate_phase": { "enum": ["pre_merge", "post_deploy"] },
    "update_id": { "type": "string", "pattern": "^refresh-[0-9]{8}-[0-9]{4}$" },
    "release_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{4}$" },
    "reference_at": { "type": "string", "format": "date-time" },
    "page_checked_at": { "type": ["string", "null"], "format": "date-time" },
    "base_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expected_changed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "url"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source_as_of": { "type": ["string", "null"], "format": "date-time" },
          "checked_at": { "type": ["string", "null"], "format": "date-time" },
          "fetched_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "coverage": { "type": "object" },
    "snapshots": { "type": "object" },
    "unresolved": { "type": "array" }
  },
  "additionalProperties": true
}
